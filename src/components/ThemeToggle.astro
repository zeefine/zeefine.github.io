---
import sunIcon from '@phosphor-icons/core/assets/light/sun-light.svg?raw';
import moonIcon from '@phosphor-icons/core/assets/light/moon-light.svg?raw';
---

<button class="theme-toggle tool-button" type="button" aria-label="切换为深色外观" title="切换为深色外观" hidden>
  <span class="theme-icon" data-theme-icon="sun" aria-hidden="true" hidden set:html={sunIcon} />
  <span class="theme-icon" data-theme-icon="moon" aria-hidden="true" set:html={moonIcon} />
</button>

---
import FooterContent from './FooterContent.astro';
import HeaderControls from './HeaderControls.astro';
import { localePath, ui, type Locale } from '../i18n/ui';
import '../styles/home.css';

interface Props {
  current: 'home' | 'blog' | 'archive';
  locale: Locale;
}
const { current, locale } = Astro.props;
---

<div class="home-shell">
  <div class="softlight" aria-hidden="true">
    <div class="light-follow"><div class="light-wash wash-sage"></div></div>
    <div class="light-follow"><div class="light-wash wash-sun"></div></div>
    <div class="light-follow"><div class="light-wash wash-mist"></div></div>
  </div>
  <header class="home-header page-width" data-site-header>
    <a class="wordmark" href={localePath('/', locale)} aria-label={ui[locale].homeLabel}>fine<span>.</span></a>
    <HeaderControls current={current} locale={locale} motion />
  </header>
  <main id="main" class="page-width"><slot /></main>
  <footer class="home-footer page-width">
    <FooterContent locale={locale} />
  </footer>
</div>
<script>
  import '../scripts/home';
</script>

---
import ThemeToggle from './ThemeToggle.astro';
import FooterContent from './FooterContent.astro';
import SiteNav from './SiteNav.astro';
import pauseIcon from '@phosphor-icons/core/assets/light/pause-light.svg?raw';
import playIcon from '@phosphor-icons/core/assets/light/play-light.svg?raw';
import '../styles/home.css';

interface Props {
  current: 'home' | 'blog' | 'archive';
}
const { current } = Astro.props;
---

<div class="home-shell">
  <div class="softlight" aria-hidden="true">
    <div class="light-follow"><div class="light-wash wash-sage"></div></div>
    <div class="light-follow"><div class="light-wash wash-sun"></div></div>
    <div class="light-follow"><div class="light-wash wash-mist"></div></div>
  </div>
  <header class="home-header page-width">
    <a class="wordmark" href="/" aria-label="Fine 博客首页">fine<span>.</span></a>
    <div class="header-end">
      <div class="header-actions" id="home-navigation">
        <SiteNav current={current} />
      </div>
      <div class="header-tools">
        <ThemeToggle />
        <button class="motion-control tool-button" type="button" aria-label="暂停背景柔光动效" title="暂停背景柔光动效" hidden>
          <span class="link-icon" data-motion-icon="pause" aria-hidden="true" set:html={pauseIcon} />
          <span class="link-icon" data-motion-icon="play" aria-hidden="true" hidden set:html={playIcon} />
        </button>
        <button class="menu-toggle tool-button" aria-controls="home-navigation" aria-expanded="false" aria-label="打开导航" hidden><span></span><span></span></button>
      </div>
    </div>
  </header>
  <main id="main" class="page-width"><slot /></main>
  <footer class="home-footer page-width">
    <FooterContent />
  </footer>
</div>
<script>
  import '../scripts/home';
</script>

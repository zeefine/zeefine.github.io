---
import { localePath, ui, type Locale } from '../i18n/ui';
interface Props {
  current: 'home' | 'blog' | 'archive';
  locale: Locale;
}
const { current, locale } = Astro.props;
const t = ui[locale];
---

<nav class="site-nav" aria-label={t.mainNav}>
  <a href={localePath('/', locale)} aria-current={current === 'home' ? 'page' : undefined}>{t.home}</a>
  <a href={localePath('/blog/', locale)} aria-current={current === 'blog' ? 'page' : undefined}>{t.blog}</a>
  <a href={localePath('/archive/', locale)} aria-current={current === 'archive' ? 'page' : undefined}>{t.archive}</a>
</nav>

---
interface Props {
  current: 'home' | 'blog' | 'archive';
}
const { current } = Astro.props;
---

<nav class="site-nav" aria-label="主导航">
  <a href="/" aria-current={current === 'home' ? 'page' : undefined}>首页</a>
  <a href="/blog/" aria-current={current === 'blog' ? 'page' : undefined}>文章</a>
  <a href="/archive/" aria-current={current === 'archive' ? 'page' : undefined}>归档</a>
</nav>

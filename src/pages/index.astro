---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteShell from '../components/SiteShell.astro';
import PostPreview from '../components/PostPreview.astro';
import arrowRightIcon from '@phosphor-icons/core/assets/light/arrow-right-light.svg?raw';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout title="Fine · Stay Curious" immersive>
  <SiteShell current="home">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-content">
        <h1 id="hero-title" lang="en">
          <span class="hero-title-line">Stay Curious.</span>
          <span class="hero-title-line">Build What's Next.</span>
        </h1>
        <p class="hero-copy"><span class="text-shimmer">开心最重要...</span><br />: )<br />: )</p>
        <a class={posts.length ? 'primary-cta' : 'text-link'} href="/blog/"><span>{posts.length ? '开始阅读' : '浏览文章'}</span><span class="link-icon" aria-hidden="true" set:html={arrowRightIcon} /></a>
      </div>
    </section>
    <section class="latest-writing" aria-labelledby="writing-title">
      <div class="section-heading"><h2 id="writing-title">最新文章</h2></div>
      {posts.length ? <div class="post-previews">
        {posts.slice(0, 3).map((post) => <PostPreview post={post} />)}
      </div> : <p class="empty-posts">第一篇记录正在酝酿中。</p>}
      {posts.length > 0 && <div class="latest-more">
        <a class="text-link" href="/blog/">
          <span>阅读更多</span>
          <span class="link-icon" aria-hidden="true" set:html={arrowRightIcon} />
        </a>
      </div>}
    </section>
  </SiteShell>
</BaseLayout>
